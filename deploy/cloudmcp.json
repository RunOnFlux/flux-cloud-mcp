{
  "version": 8,
  "name": "cloudmcp",
  "description": "Flux Cloud MCP server: lets AI agents quote, deploy and manage apps on Flux Cloud. https://github.com/RunOnFlux/flux-cloud-mcp",
  "owner": "196GJWyLxzAw3MirTT7Bqs2iGpUQio29GH",
  "compose": [
    {
      "name": "mcp",
      "description": "Streamable HTTP MCP endpoint at /mcp, stateless, holds no keys. Installs the npm package on start.",
      "repotag": "node:22-bookworm-slim",
      "ports": [35127],
      "domains": ["mcp.runonflux.com,mcp.runonflux.io"],
      "environmentParameters": ["PORT=3000"],
      "commands": [
        "sh",
        "-c",
        "npm install -g --no-fund --no-audit @runonflux/flux-cloud-mcp@0.2.7 && exec flux-cloud-mcp-http"
      ],
      "containerPorts": [3000],
      "containerData": "/data",
      "cpu": 0.5,
      "ram": 500,
      "hdd": 2,
      "repoauth": ""
    }
  ],
  "instances": 3,
  "contacts": [],
  "geolocation": [],
  "expire": 88000,
  "nodes": [],
  "staticip": false,
  "enterprise": ""
}
